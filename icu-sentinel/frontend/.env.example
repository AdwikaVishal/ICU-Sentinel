# Base URL for the P3 API.
#
# Leave empty to use the Vite development proxy (recommended for local use):
#   /api and /health are proxied to http://127.0.0.1:8000
#
# Set an absolute URL when the frontend is served separately from the API:
#   VITE_P3_API_BASE=http://127.0.0.1:8000
VITE_P3_API_BASE=
